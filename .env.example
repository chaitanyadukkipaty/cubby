# Local development. On a server, install.sh writes /opt/cubby/cubby.env instead.
PORT=8080
# Apps are served at <app>.<BASE_DOMAIN>
BASE_DOMAIN=localhost:8080
PUBLIC_URL=http://localhost:8080
DATA_DIR=./data

# First boot only: creates the admin account and initial settings.
CUBBY_ADMIN_EMAIL=admin@example.com
CUBBY_ADMIN_PASSWORD=change-me-please
CUBBY_SIGNUP_CODE=otter-maple-42
# Display name shown on the dashboard and when connecting agents (1-60 chars). Default: "<admin email name>'s Cubby".
CUBBY_SERVER_NAME=My Cubby
MAX_APPS_PER_USER=10
MAX_DEPLOY_MB=50

# Daily check for a newer Cubby release (the only outbound request). 0 turns it off.
CUBBY_UPDATE_CHECK=1

# Shared PocketBase
PB_URL=http://127.0.0.1:8090
PB_BIN=./bin/pocketbase
PB_SPAWN=1
PB_SUPERUSER_EMAIL=superuser@cubby.internal
PB_SUPERUSER_PASSWORD=change-me-please-123
