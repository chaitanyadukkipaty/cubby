{
  "name": "cubby",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "cli"
  ],
  "scripts": {
    "setup": "node scripts/install-pocketbase.mjs && npm install",
    "dev": "npm run start -w server",
    "cubby": "node cli/src/index.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.js",
    "coverage": "c8 --reporter=text --reporter=html --reporter=lcov --report-dir=coverage --include=server/src/** --include=cli/src/** node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "c8": "12.0.0"
  }
}
