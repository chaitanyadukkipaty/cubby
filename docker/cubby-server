#!/usr/bin/env bash
# Manage a Cubby install. Installed to /usr/local/bin/cubby-server by install.sh.
# Everything runs inside main(), so bash has read the whole script before an upgrade replaces this file.
set -euo pipefail

CUBBY_HOME="${CUBBY_HOME:-/opt/cubby}"
CUBBY_BIN="${CUBBY_BIN:-/usr/local/bin/cubby-server}"
ENV_FILE="$CUBBY_HOME/cubby.env"
SRC="$CUBBY_HOME/src"
IMAGE=cubby:local
NAME=cubby
VOLUME=cubby-data
# Host paths for fail2ban. CUBBY_HOST_ROOT moves them all, for tests only.
HOST_ROOT="${CUBBY_HOST_ROOT:-}"
F2B_ETC="$HOST_ROOT/etc/fail2ban"
SYSTEMD_DIR="$HOST_ROOT/etc/systemd/system"
LOG_DIR="$HOST_ROOT/var/log/cubby"
F2B_DIR="$HOST_ROOT/var/lib/cubby/fail2ban" # ban events in, unban requests out; mounted into the container
F2B_JAILS=(cubby-probe cubby-ratelimit)

die() { echo "error: $*" >&2; exit 1; }

get_env() { sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1; }

set_env() { # key value
  local tmp
  tmp="$(mktemp "$ENV_FILE.XXXXXX")"
  grep -v "^$1=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$ENV_FILE"
}

build_image() {
  local commit tag
  read -r commit tag < <(cubby_build_info "$SRC")
  docker build -q -t "$IMAGE" --build-arg "CUBBY_COMMIT=${commit:-}" --build-arg "CUBBY_TAG=${tag:-}" "$SRC" >/dev/null
}

# Host ports, chosen once by install.sh. Installs from before they were stored use 80 and 8090.
http_port() { get_env CUBBY_HTTP_PORT | grep . || echo 80; }
pb_port() { get_env CUBBY_PB_PORT | grep . || echo 8090; }

# Refuses if another process holds one of the ports. Never moves to another port: the port is part of every URL
# the CLI and app folders have stored. Ports held by our own container don't count; it's about to be replaced.
check_ports() {
  local port holder
  for port in "$@"; do
    holder="$(cubby_port_holder "$port" "$NAME")"
    [[ -z "$holder" ]] || die "Port $port is in use by $holder. Free it, then run: sudo cubby-server rebuild"
  done
}

start_container() {
  local http pb
  http="$(http_port)"
  pb="$(pb_port)"
  local ports=(-p "$http:80" -p "127.0.0.1:$pb:8090") hostports=("$http" "$pb")
  # Plain HTTP (IP mode) doesn't use 443, so a busy 443 doesn't block it.
  if [[ "$(get_env CUBBY_HTTPS)" == 1 ]]; then ports+=(-p 443:443); hostports+=(443); fi
  check_ports "${hostports[@]}"
  # With fail2ban on, Caddy writes the access log fail2ban reads, and Cubby sees ban events and files unban requests.
  local f2b=()
  if fail2ban_enabled; then
    f2b=(-v "$LOG_DIR":/var/log/cubby -e CUBBY_ACCESS_LOG=/var/log/cubby/access.log
      -v "$F2B_DIR":/var/lib/cubby/fail2ban -e CUBBY_FAIL2BAN_DIR=/var/lib/cubby/fail2ban)
  fi
  docker rm -f "$NAME" >/dev/null 2>&1 || true
  docker run -d --name "$NAME" --restart unless-stopped "${ports[@]}" \
    -v "$VOLUME":/data ${f2b[@]+"${f2b[@]}"} --env-file "$ENV_FILE" "$IMAGE" >/dev/null
}

container_running() { docker ps -q --filter "name=^${NAME}$" | grep -q .; }

# --- fail2ban -------------------------------------------------------------------------------------
# Cubby's jails ban IPs that probe for secret files or keep hitting the login limit, in Docker's DOCKER-USER chain
# (published ports skip INPUT). The container never talks to fail2ban: it reads ban events from $F2B_DIR/events and
# drops unban requests in $F2B_DIR/requests, which a systemd path unit hands to `fail2ban process-requests`.

fail2ban_enabled() { [[ "$(get_env CUBBY_FAIL2BAN)" == 1 ]]; }

fail2ban_install_package() {
  fail2ban-client --version >/dev/null 2>&1 && return 0
  echo "Installing fail2ban…"
  if command -v apt-get >/dev/null; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq fail2ban >/dev/null 2>&1 || { apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq fail2ban >/dev/null; } || true
  fi
  if ! fail2ban-client --version >/dev/null 2>&1 && command -v dnf >/dev/null; then
    dnf install -y -q fail2ban || { dnf install -y -q epel-release && dnf install -y -q fail2ban; } || true # RHEL ships it in EPEL
  fi
  fail2ban-client --version >/dev/null 2>&1 || die "Couldn't install fail2ban. Install it with your package manager, then re-run: sudo cubby-server fail2ban enable"
}

# Cubby's filters, action and jails (from this version's source), and the systemd units. Safe to repeat.
fail2ban_install_config() {
  local conf="$SRC/docker/fail2ban"
  [[ -d "$conf" ]] || die "$conf is missing; run: sudo cubby-server upgrade"
  mkdir -p "$F2B_ETC/filter.d" "$F2B_ETC/action.d" "$F2B_ETC/jail.d" "$LOG_DIR" "$SYSTEMD_DIR/fail2ban.service.d"
  mkdir -p "$F2B_DIR/events" "$F2B_DIR/requests" "$F2B_DIR/results" "$F2B_DIR/tmp"
  chmod 700 "$LOG_DIR" "$F2B_DIR"
  touch "$LOG_DIR/access.log" # fail2ban refuses a jail whose log doesn't exist yet
  cp "$conf"/filter.d/cubby-*.conf "$F2B_ETC/filter.d/"
  cp "$conf"/action.d/cubby-*.conf "$F2B_ETC/action.d/"
  sed -e "s#__LOG__#$LOG_DIR/access.log#g" -e "s#__CUBBY_BIN__#$CUBBY_BIN#g" -e "s#__CUBBY_HOME__#$CUBBY_HOME#g" "$conf/jail.d/cubby.conf" > "$F2B_ETC/jail.d/cubby.conf"
  # Debian 12 without rsyslog has no auth.log, so the stock sshd jail can't start and takes fail2ban down with it.
  # Debian's fix: read sshd from the journal.
  if [[ -f "$F2B_ETC/paths-debian.conf" && ! -f "$HOST_ROOT/var/log/auth.log" ]]; then
    printf '[sshd]\nbackend = systemd\n' > "$F2B_ETC/jail.d/cubby-sshd.conf"
  fi
  # The DOCKER-USER chain exists once Docker runs; fail2ban fails to add its rules before that.
  printf '[Unit]\nAfter=docker.service\n' > "$SYSTEMD_DIR/fail2ban.service.d/cubby.conf"
  cat > "$SYSTEMD_DIR/cubby-fail2ban.path" <<UNIT
[Unit]
Description=Cubby unban requests

[Path]
DirectoryNotEmpty=$F2B_DIR/requests

[Install]
WantedBy=multi-user.target
UNIT
  cat > "$SYSTEMD_DIR/cubby-fail2ban.service" <<UNIT
[Unit]
Description=Answer Cubby unban requests

[Service]
Type=oneshot
Environment=CUBBY_HOME=$CUBBY_HOME
ExecStart=$CUBBY_BIN fail2ban process-requests
UNIT
}

valid_ip() { [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ || ( "$1" =~ ^[0-9A-Fa-f:.]{2,45}$ && "$1" == *:* ) ]]; }
valid_jail() { [[ " ${F2B_JAILS[*]} " == *" $1 "* ]]; }

# Writes a file into $F2B_DIR/<dir> by rename, so a reader never sees half of it.
f2b_drop() { # dir name content
  local tmp="$F2B_DIR/tmp/$2"
  printf '%s\n' "$3" > "$tmp" && mv "$tmp" "$F2B_DIR/$1/$2"
}

# Called by fail2ban (action.d/cubby-events.conf) for every ban and unban in Cubby's jails.
cmd_fail2ban_event() { # ban|unban ip jail [bantime]
  local kind="${1:-}" ip="${2:-}" jail="${3:-}" bantime="${4:-}" now extra=""
  [[ "$kind" == ban || "$kind" == unban ]] || die "usage: cubby-server fail2ban event ban|unban <ip> <jail> [bantime]"
  valid_ip "$ip" || die "not an IP address: $ip"
  valid_jail "$jail" || die "not a Cubby jail: $jail"
  if [[ "$kind" == ban ]]; then
    [[ "$bantime" =~ ^-?[0-9]+$ ]] || die "bantime must be seconds: $bantime"
    extra=",\"bantime\":$bantime"
  fi
  [[ -d "$F2B_DIR/events" ]] || return 0 # fail2ban is being turned off
  now="$(date +%s)"
  f2b_drop events "$now-$kind-${ip//:/_}-$jail-$$.json" "{\"event\":\"$kind\",\"ip\":\"$ip\",\"jail\":\"$jail\",\"time\":$now$extra}"
}

# Lifts a ban in Cubby's jails only (never sshd or the admin's own jails). Prints the jails it was lifted from.
f2b_unban() { # ip
  local jail lifted=()
  for jail in "${F2B_JAILS[@]}"; do
    if [[ "$(fail2ban-client get "$jail" banned "$1" 2>/dev/null)" == 1 ]]; then
      fail2ban-client set "$jail" unbanip "$1" >/dev/null && lifted+=("$jail")
    fi
  done
  [[ ${#lifted[@]} -gt 0 ]] && echo "${lifted[*]}"
}

json_string() { sed -n "s/.*\"$1\":\"\([^\"\\\\]*\)\".*/\\1/p" | head -n 1; }

# Run by cubby-fail2ban.service whenever Cubby drops a request. Requests come from the container, so they're
# untrusted: the only thing one can do is lift a ban in Cubby's own jails.
cmd_fail2ban_process_requests() {
  local file id body action ip jails
  for file in "$F2B_DIR"/requests/*; do
    [[ -f "$file" ]] || continue
    id="$(basename "$file" .json)"
    body="$(head -c 4096 "$file")"
    rm -f "$file"
    [[ "$id" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || continue
    action="$(printf '%s' "$body" | json_string action)"
    ip="$(printf '%s' "$body" | json_string ip)"
    if [[ "$action" != unban ]] || ! valid_ip "$ip"; then
      f2b_drop results "$id.json" "{\"id\":\"$id\",\"ok\":false,\"error\":\"Not a valid unban request.\"}"
    elif jails="$(f2b_unban "$ip")"; then
      f2b_drop results "$id.json" "{\"id\":\"$id\",\"ok\":true}"
    else
      f2b_drop results "$id.json" "{\"id\":\"$id\",\"ok\":false,\"error\":\"$ip isn't banned by Cubby's jails.\"}"
    fi
  done
}

cmd_fail2ban_disable() {
  rm -f "$F2B_ETC/jail.d/cubby.conf" "$F2B_ETC"/filter.d/cubby-*.conf "$F2B_ETC"/action.d/cubby-*.conf
  systemctl disable --now cubby-fail2ban.path >/dev/null 2>&1 || true
  rm -f "$SYSTEMD_DIR/cubby-fail2ban.path" "$SYSTEMD_DIR/cubby-fail2ban.service" "$SYSTEMD_DIR/fail2ban.service.d/cubby.conf"
  systemctl daemon-reload
  # Restarting without the jails also lifts their bans. The package and the stock sshd jail stay (and so does the
  # sshd journal fix, which the stock jail needs to start).
  ! fail2ban-client --version >/dev/null 2>&1 || systemctl restart fail2ban
  set_env CUBBY_FAIL2BAN 0
  container_running && start_container
  rm -rf "$LOG_DIR" "$F2B_DIR" # visitor IPs aren't kept once nothing reads them
  echo "fail2ban is off for Cubby. Ban history stays in the Security tab for 90 days."
}

cmd_fail2ban_status() {
  if ! fail2ban_enabled; then
    echo "fail2ban is off. Turn it on with: sudo cubby-server fail2ban enable"
    return 0
  fi
  local jail
  for jail in "${F2B_JAILS[@]}"; do fail2ban-client status "$jail"; done
}

cmd_fail2ban_unban() { # ip
  local ip="${1:-}" jails
  valid_ip "$ip" || die "not an IP address: $ip (usage: cubby-server fail2ban unban <ip>)"
  jails="$(f2b_unban "$ip")" || die "$ip isn't banned by Cubby's jails."
  echo "Unbanned $ip ($jails)."
}

cmd_fail2ban_enable() {
  local restart=1
  [[ "${1:-}" != "--no-restart" ]] || restart=0
  fail2ban_install_package
  fail2ban_install_config
  set_env CUBBY_FAIL2BAN 1
  systemctl daemon-reload
  systemctl enable --now cubby-fail2ban.path >/dev/null 2>&1
  systemctl enable fail2ban >/dev/null 2>&1 || true
  systemctl restart fail2ban # a reload doesn't add actions to running jails
  if [[ "$restart" == 1 ]] && container_running; then
    start_container
    wait_healthy || echo "Cubby didn't come back up. Check: cubby-server logs" >&2
  fi
  echo "fail2ban is on: IPs that scan for secret files or keep hitting the login limit are banned from Cubby."
  echo "See bans with: sudo cubby-server fail2ban status   (or the Security tab on the Admin page)"
}

# /api/info of the running server ("" if it isn't answering). Asked inside the container, like its HEALTHCHECK: with a
# domain, Caddy answers plain HTTP with a redirect to HTTPS (no body), so going through the published port never worked.
server_info() {
  docker exec "$NAME" curl -fsS --max-time 5 http://127.0.0.1:8080/api/info 2>/dev/null || true
}
json_field() { sed -n "s/.*\"$1\":\"\\([^\"]*\\)\".*/\\1/p"; }

wait_healthy() {
  for _ in $(seq 1 "${CUBBY_HEALTH_TRIES:-60}"); do
    [[ -n "$(server_info)" ]] && return 0
    sleep "${CUBBY_HEALTH_SLEEP:-2}"
  done
  return 1
}

# Channel and ref of this install. Installs from before channels existed followed a branch (main).
install_channel() { get_env CUBBY_INSTALL_CHANNEL | grep . || echo ref; }
install_ref() { get_env CUBBY_INSTALL_REF | grep . || echo main; }

cmd_upgrade() {
  local version="" ref="" backup=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --version) version="${2:-}"; shift 2 ;;
      --version=*) version="${1#*=}"; shift ;;
      --ref) ref="${2:-}"; shift 2 ;;
      --ref=*) ref="${1#*=}"; shift ;;
      --no-backup) backup=0; shift ;;
      *) die "unknown option $1 (usage: cubby-server upgrade [--version X.Y.Z | --ref <branch|tag|commit>] [--no-backup])" ;;
    esac
  done
  if [[ -z "$version" && -z "$ref" && "$(install_channel)" == "ref" ]]; then
    ref="$(install_ref)" # stay on the branch this server follows
  fi
  cubby_resolve "$version" "$ref" || exit 1
  [[ -z "$CUBBY_TARGET_NOTE" ]] || echo "note: $CUBBY_TARGET_NOTE"

  local before_version before_commit
  before_version="$(server_info | json_field version)"
  before_commit="$(git -C "$SRC" rev-parse HEAD 2>/dev/null || true)"

  cubby_checkout "$SRC" "$CUBBY_TARGET_REF" || exit 1
  if [[ "$(git -C "$SRC" rev-parse HEAD)" == "$before_commit" && -n "$before_version" ]]; then
    set_env CUBBY_INSTALL_CHANNEL "$CUBBY_TARGET_CHANNEL"
    set_env CUBBY_INSTALL_REF "$CUBBY_TARGET_REF"
    echo "Already on Cubby ${before_version} ($CUBBY_TARGET_REF). Nothing to do."
    return 0
  fi

  if [[ "$backup" == 1 ]] && container_running; then
    echo "Backing up before upgrading…"
    if ! docker exec "$NAME" node /app/server/src/admin-tasks.js backup >/dev/null; then
      [[ -z "$before_commit" ]] || git -C "$SRC" -c advice.detachedHead=false checkout -q --detach "$before_commit"
      die "The backup failed, so nothing was changed. Re-run with --no-backup to upgrade anyway."
    fi
  fi

  echo "Building Cubby from $CUBBY_TARGET_REF (takes a minute)…"
  build_image
  start_container
  set_env CUBBY_INSTALL_CHANNEL "$CUBBY_TARGET_CHANNEL"
  set_env CUBBY_INSTALL_REF "$CUBBY_TARGET_REF"
  if ! wait_healthy; then
    echo "Cubby didn't come back up. Check: cubby-server logs" >&2
    [[ -z "$before_version" ]] || echo "Roll back with: sudo cubby-server upgrade --version ${before_version%%[-+]*}" >&2
    exit 1
  fi
  local after
  after="$(server_info | json_field version)"
  echo "Upgraded Cubby ${before_version:-?} → ${after:-?} ($CUBBY_TARGET_REF). Data is untouched."
  if fail2ban_enabled; then
    fail2ban_install_config # this version's filters and jails
    systemctl daemon-reload
    systemctl restart fail2ban
  elif [[ -z "$(get_env CUBBY_FAIL2BAN)" ]]; then
    echo "Ban IPs that scan for secret files: sudo cubby-server fail2ban enable"
  fi

  # Install this version's cubby-server last, by rename, so the running copy is never edited in place.
  if [[ -f "$SRC/docker/cubby-server" ]]; then
    cp "$SRC/docker/cubby-server" "$CUBBY_BIN.new" && chmod 755 "$CUBBY_BIN.new" && mv "$CUBBY_BIN.new" "$CUBBY_BIN"
  fi
}

cmd_version() {
  local info current commit latest
  info="$(server_info)"
  current="$(printf '%s' "$info" | json_field version)"
  commit="$(printf '%s' "$info" | json_field commit)"
  [[ -n "$commit" ]] || commit="$(git -C "$SRC" rev-parse --short=7 HEAD 2>/dev/null || true)"
  echo "Running:   ${current:-unknown (server not answering)}"
  echo "Commit:    ${commit:-unknown}"
  echo "Follows:   $(install_channel) $(install_ref)"
  latest="$(cubby_latest_release)"
  if [[ -z "$latest" ]]; then
    echo "Latest:    unknown (no releases, or GitHub can't be reached)"
  elif [[ -n "$current" ]] && cubby_newer "$latest" "$current"; then
    echo "Latest:    $latest (update available: sudo cubby-server upgrade)"
  else
    echo "Latest:    $latest"
  fi
}

usage() {
  cat <<USAGE
cubby-server — manage this Cubby install
  status | logs [lines] | restart
  version                     running version, commit, what it follows, latest release
  upgrade                     latest release (or the branch you follow); backs up first, data kept
  upgrade --version X.Y.Z     a specific release (also to roll back)
  upgrade --ref <ref>         any branch, tag or commit (not a release)
  code                        show the signup code
  reset-password <email> <pw> reset any account's password
  backup                      run a backup now
  backups                     list available backups (7 nightly kept)
  restore <YYYY-MM-DD>        restore all data to a backup
  set-domain <domain>         switch from IP to a real domain with HTTPS
  fail2ban [status]           what Cubby's jails have banned (IPs scanning for secret files, login brute force)
  fail2ban enable | disable   install fail2ban and Cubby's jails / remove the jails and the access log
  fail2ban unban <ip>         lift a ban (also in the Admin page's Security tab)
USAGE
}

main() {
  [[ $EUID -eq 0 || -n "${CUBBY_TEST_NONROOT:-}" ]] || { echo "Run with sudo." >&2; exit 1; }
  [[ -f "$ENV_FILE" ]] || { echo "Cubby isn't installed ($ENV_FILE missing)." >&2; exit 1; }
  if [[ -f "$SRC/docker/ref.sh" ]]; then
    # shellcheck source=ref.sh
    source "$SRC/docker/ref.sh"
  else
    die "$SRC/docker/ref.sh is missing; re-run the installer."
  fi

  case "${1:-help}" in
    status)
      docker ps --filter "name=^${NAME}$" --format 'table {{.Status}}\t{{.Ports}}'
      grep -E '^(PUBLIC_URL|BASE_DOMAIN|CUBBY_HTTP_PORT|CUBBY_PB_PORT|CUBBY_INSTALL_CHANNEL|CUBBY_INSTALL_REF)=' "$ENV_FILE"
      ;;
    logs) docker logs --tail "${2:-200}" -f "$NAME" ;;
    restart) docker restart "$NAME" >/dev/null && echo "Restarted." ;;
    rebuild)
      build_image
      start_container
      ;;
    upgrade) shift; cmd_upgrade "$@" ;;
    fail2ban)
      case "${2:-status}" in
        enable) cmd_fail2ban_enable "${3:-}" ;;
        event) shift 2; cmd_fail2ban_event "$@" ;;
        process-requests) cmd_fail2ban_process_requests ;;
        status) cmd_fail2ban_status ;;
        disable) cmd_fail2ban_disable ;;
        unban) cmd_fail2ban_unban "${3:-}" ;;
        *) echo "usage: cubby-server fail2ban enable | disable | status | unban <ip>"; exit 1 ;;
      esac
      ;;
    version) cmd_version ;;
    code) docker exec "$NAME" node /app/server/src/admin-tasks.js code ;;
    reset-password)
      [[ $# -eq 3 ]] || { echo "usage: cubby-server reset-password <email> <new-password>"; exit 1; }
      docker exec "$NAME" node /app/server/src/admin-tasks.js reset-password "$2" "$3"
      ;;
    backup)
      docker exec "$NAME" node /app/server/src/admin-tasks.js backup
      docker run --rm -v "$VOLUME":/data "$IMAGE" sh -c 'ls -1 /data/pb_data/backups /data/backups 2>/dev/null'
      ;;
    backups)
      docker run --rm -v "$VOLUME":/data "$IMAGE" sh -c 'ls -1 /data/pb_data/backups 2>/dev/null | sed -n "s/^cubby-\(.*\)\.zip$/\1/p"'
      ;;
    restore)
      [[ $# -eq 2 ]] || { echo "usage: cubby-server restore <YYYY-MM-DD>   (see: cubby-server backups)"; exit 1; }
      local date="$2" ok
      echo "This restores ALL apps and accounts to $date. Anything newer is lost."
      read -r -p "Type 'restore' to continue: " ok </dev/tty
      [[ "$ok" == "restore" ]] || exit 1
      docker stop "$NAME" >/dev/null
      docker run --rm -v "$VOLUME":/data "$IMAGE" bash -euc "
        cd /data
        test -f pb_data/backups/cubby-$date.zip || { echo 'No backup for $date'; exit 1; }
        mkdir -p /tmp/restore && cd /tmp/restore && unzip -q /data/pb_data/backups/cubby-$date.zip
        cd /data/pb_data && find . -mindepth 1 -maxdepth 1 ! -name backups -exec rm -rf {} +
        cp -a /tmp/restore/. /data/pb_data/
        if [ -f /data/backups/sites-$date.tar.gz ]; then rm -rf /data/sites && tar -xzf /data/backups/sites-$date.tar.gz -C /data; fi
      "
      docker start "$NAME" >/dev/null
      echo "Restored $date."
      ;;
    set-domain)
      [[ $# -eq 2 ]] || { echo "usage: cubby-server set-domain <domain>   (point <domain> and *.<domain> at this server first)"; exit 1; }
      # Let's Encrypt only checks ports 80 and 443, so HTTPS can't move to other ports.
      local port holder
      for port in 80 443; do
        holder="$(cubby_port_holder "$port" "$NAME")"
        [[ -z "$holder" ]] || die "Port $port is in use by $holder. A domain with HTTPS needs ports 80 and 443 (Let's Encrypt checks them); free them and re-run."
      done
      set_env BASE_DOMAIN "$2"
      set_env PUBLIC_URL "https://$2"
      set_env CUBBY_HTTPS 1
      set_env CUBBY_HTTP_PORT 80
      start_container
      echo "Now serving https://$2 — app URLs changed to https://<app>.$2. Everyone must re-run:"
      echo "  cubby login https://$2 --token <token>"
      ;;
    *) usage ;;
  esac
}

main "$@"
exit
